{
  "name": "gameweld",
  "private": true,
  "version": "0.0.0",
  "description": "Production management system for small, agile game development teams",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w apps/web",
    "test:unit": "vitest run --project domain --project web",
    "test:integration": "vitest run --project api",
    "test:e2e": "playwright test",
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web; wait"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
